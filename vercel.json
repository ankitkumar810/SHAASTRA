{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/login",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "source": "/list",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "source": "/map",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "source": "/find-someone",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "source": "/report-safe",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "source": "/",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}