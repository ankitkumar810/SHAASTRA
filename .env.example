NEXT_PUBLIC_APP_ENV=development

# Database configuration (Phase 2 - Prisma / PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/shaastra?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/shaastra?schema=public

